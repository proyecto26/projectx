{
  "name": "@proyecto26/temporal-workflows",
  "version": "0.1.0",
  "description": "NestJS module to run Temporal workers and clients",
  "license": "MIT",
  "author": "Proyecto 26 <https://github.com/proyecto26>",
  "homepage": "https://github.com/proyecto26/projectx/tree/develop/packages/workflows#readme",
  "bugs": {
    "url": "https://github.com/proyecto26/projectx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proyecto26/projectx.git",
    "directory": "packages/workflows"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "biome check .",
    "test": "echo 'no tests'",
    "prepack": "pnpm run build",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "dependencies": {
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/proto": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "publint": "^0.3.25",
    "@arethetypeswrong/cli": "^0.18.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/config": "^3.0.0 || ^4.0.0 || ^12.0.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/proto": "^1.25.0",
    "@temporalio/worker": "^1.25.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "temporal",
    "workflow",
    "nestjs",
    "worker",
    "durable-execution"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  }
}
