                  "name": "ps7Title",
                  "fill": "$--foreground",
                  "content": "7. Contact Us",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "P30xj",
                  "name": "ps7Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "For privacy-related questions or concerns, contact our Data Protection Officer at privacy@projectx.com or through the Help Center in your account settings.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
