              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "LsnHC",
                  "name": "ppTitle",
                  "fill": "$--foreground",
                  "content": "Privacy Policy",
                  "fontFamily": "Inter",
                  "fontSize": 36,
                  "fontWeight": "700",
                  "letterSpacing": -1
                },
                {
                  "type": "text",
                  "id": "euLmY",
                  "name": "ppDate",
                  "fill": "$--muted-foreground",
                  "content": "Last updated: February 25, 2026",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "text",
              "id": "YQMad",
              "name": "ppIntro",
              "fill": "$--foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "At ProjectX, we take your privacy seriously. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our marketplace platform.",
              "lineHeight": 1.7,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "gpJep",
              "name": "ppSec1",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "5juYI",
                  "name": "ps1Title",
                  "fill": "$--foreground",
                  "content": "1. Information We Collect",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Frwqy",
                  "name": "ps1Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We collect information you provide directly, including name, email address, shipping address, payment information, and phone number. We also automatically collect device information, IP address, browser type, pages visited, and interaction data through cookies and similar technologies.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "FnxuQ",
              "name": "ppSec2",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "UENX3",
                  "name": "ps2Title",
                  "fill": "$--foreground",
                  "content": "2. How We Use Your Information",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ldMVP",
                  "name": "ps2Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We use your information to process transactions, manage your account, send order updates, improve our services, personalize your experience, detect and prevent fraud, and comply with legal obligations. We may also use your data for marketing communications, which you can opt out of at any time.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "SKwkj",
              "name": "ppSec3",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "up5qT",
                  "name": "ps3Title",
                  "fill": "$--foreground",
                  "content": "3. Information Sharing",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "D9LZd",
                  "name": "ps3Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We do not sell your personal information. We may share data with payment processors (Stripe), shipping carriers, analytics providers, and law enforcement when required. Sellers receive only the information necessary to fulfill orders.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "jtEYN",
              "name": "ppSec4",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "H7JyH",
                  "name": "ps4Title",
                  "fill": "$--foreground",
                  "content": "4. Data Security",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "NXuWl",
                  "name": "ps4Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We implement industry-standard security measures including encryption, secure servers, and regular security audits. However, no method of transmission over the Internet is 100% secure, and we cannot guarantee absolute security of your data.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "nFjpg",
              "name": "ppSec5",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "T3sFR",
                  "name": "ps5Title",
                  "fill": "$--foreground",
                  "content": "5. Cookies & Tracking",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "dOHfO",
                  "name": "ps5Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We use cookies and similar tracking technologies to enhance your browsing experience, analyze site traffic, and personalize content. You can control cookie preferences through your browser settings. Disabling cookies may limit some platform features.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ml1ns",
              "name": "ppSec6",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "n0QzG",
                  "name": "ps6Title",
                  "fill": "$--foreground",
                  "content": "6. Your Rights",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "pTZ4n",
                  "name": "ps6Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "You have the right to access, correct, or delete your personal data. You may also request data portability or restrict processing. To exercise these rights, contact us at privacy@projectx.com. We will respond to your request within 30 days.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ir1SX",
              "name": "ppSec7",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
