                  "type": "text",
                  "id": "pLadj",
                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": 776,
                  "content": "Use Card / Metric (vqcBE) for KPI tiles so dashboards stay visually unified.",
