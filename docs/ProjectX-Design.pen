                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": 776,
                  "content": "Don't stack multiple high-elevation cards — it flattens hierarchy and adds visual noise.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "8SMCY",
                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": 776,
                  "content": "Don't use 2xl shadows on list rows — reserve for overlay surfaces like dialogs.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "t4vBL",
                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": 776,
                  "content": "Don't mix card radii in the same grid — pick one (12px) and stick with it.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "T9paO",
                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": 776,
                  "content": "Don't combine heavy shadows with thick borders — choose one depth cue, not both.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "VmNcG",
                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": 776,
                  "content": "Don't nest cards more than one level deep — use dividers or spacing instead.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "r1aCM",
                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": 776,
                  "content": "Don't apply elevation to disabled cards — keep them flat with reduced opacity.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
