                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": 776,
                  "content": "Keep card padding consistent: 20–24px for content cards, 16px for compact list items.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
