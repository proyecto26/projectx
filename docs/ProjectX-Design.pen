                  "type": "text",
                  "id": "jRqim",
                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": 776,
                  "content": "Reserve elevation shadows for floating surfaces — menus, modals, tooltips, hover states.",
