                  "content": "Users agree not to engage in fraudulent activities, sell prohibited items, manipulate reviews or ratings, harass other users, or violate any applicable laws. ProjectX reserves the right to suspend or terminate accounts that violate these guidelines.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "nF9kK",
              "name": "section4",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "UczAD",
                  "name": "sec4Title",
                  "fill": "$--foreground",
                  "content": "4. Payments & Transactions",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "lXXq2",
                  "name": "sec4Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "All payments are processed securely through Stripe. Buyers agree to pay the listed price plus applicable taxes and shipping. Sellers receive payment after order confirmation and delivery, subject to our payment schedule. Refunds are handled according to our Refund Policy.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "kvOsY",
              "name": "section5",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "oQuFF",
                  "name": "sec5Title",
                  "fill": "$--foreground",
                  "content": "5. Intellectual Property",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "yPXgg",
                  "name": "sec5Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "All content on ProjectX, including logos, designs, text, and software, is the property of ProjectX or its licensors. Sellers retain ownership of their product listings but grant ProjectX a license to display and promote their content on the platform.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "dV5kJ",
              "name": "section6",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
